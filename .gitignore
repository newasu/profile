# Allowlist: this repo is PUBLIC (serves profile.wkneil.com).
# Everything is ignored by default so personal documents dropped in this folder
# (letters, salary requests, certifications) can never be committed by accident.
# To publish a new file, add a `!` line for it here.
/*
!/.gitignore
!/CNAME
!/index.html
!/og-image.png
!/WK_CV.json
!/PORTFOLIO_RULES.md
!/cv/

# Junk inside allowed folders
.DS_Store
